{
  "protect-env-files": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file|replace_file_content|multi_replace_file_content|write_to_file|grep_search|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/block-env.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
